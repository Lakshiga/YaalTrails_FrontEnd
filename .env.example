# Copy this file to .env and fill in your values. .env is git-ignored — never commit keys.
# After changing .env, restart `npm start` (it regenerates src/environments/env.generated.ts).

# The backend API (local: http://localhost:5001/api, live: http://yaaltrails.runasp.net/api).
NG_APP_API_BASE_URL=http://localhost:5001/api

# Google Maps JavaScript API browser key — only used to draw the map. Leave empty to use OpenStreetMap.
# Restrict it in Google Cloud Console: Application restrictions → Websites (http://localhost:4200/*, your live site),
# API restrictions → Maps JavaScript API only. Places, routes and photos never use this key (the backend has its own).
NG_APP_GOOGLE_MAPS_API_KEY=

# Map ID for Advanced Markers (DEMO_MAP_ID works for development).
NG_APP_GOOGLE_MAP_ID=DEMO_MAP_ID

# Client credentials: the site swaps these for a short-lived client token (POST /api/auth/client-token), which every
# API call must carry. The backend stores only the secret's SHA-256 hash (ClientAuth:Clients in appsettings.json).
NG_APP_CLIENT_ID=yaal-web
NG_APP_CLIENT_SECRET=
